# ─── TxLINE API credentials ─────────────────────────────────────────────────
# Both headers are required on every TxLINE request.
# Obtain via: cd packages/core && npm run setup

# JWT from TxLINE guest auth + on-chain activation flow
TXLINE_JWT=

# Static API token (separate from JWT)
TXLINE_API_TOKEN=

# ─── Solana (used by core setup only) ────────────────────────────────────────
WALLET_KEYPAIR_PATH=~/.config/solana/id.json
RPC_URL=https://api.mainnet-beta.solana.com

# ─── App config ──────────────────────────────────────────────────────────────
# Port the REST API listens on (default: 3001)
PORT=3001
LOG_LEVEL=info   # debug | info | warn | error
